  time := Polynomial.C (affineExactlyOneStructuredRowFamilyStepCoeff
      labelWidth stateWidth cellCounts) * Polynomial.X ^ 2 + 2
  outputsFun := fun seeds => by
    have builderRun := affineExactlyOneStructuredRowMarkedFamilyRev_run
