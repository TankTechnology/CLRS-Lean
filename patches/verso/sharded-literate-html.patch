+private def configUsage :=
+  "Usage: verso-literate-html OUTDIR MODULE-MAP [CONFIG] " ++
+  "[--emit-list FILE] [--metadata-out FILE] [--coordinator] [--hover-id-offset NAT]"
+
+private def parseConfigArgs (args : List String) (positionals : Array String := #[])
+    (emitListFile : Option System.FilePath := none)
+    (metadataOut : Option System.FilePath := none) (coordinator : Bool := false)
+    (hoverIdOffset : Nat := 0) : Except String Config :=
+  match args with
+  | [] =>
+    match positionals.toList with
+    | [outputDir, moduleMapFile] =>
+      pure {
+        outputDir := outputDir
+        moduleMapFile := moduleMapFile
+        emitListFile := emitListFile
+        metadataOut := metadataOut
+        coordinator := coordinator
+        hoverIdOffset := hoverIdOffset
+      }
+    | [outputDir, moduleMapFile, configFile] =>
+      pure {
+        outputDir := outputDir
+        moduleMapFile := moduleMapFile
+        configFile := some configFile
+        emitListFile := emitListFile
+        metadataOut := metadataOut
+        coordinator := coordinator
+        hoverIdOffset := hoverIdOffset
+      }
+    | _ => throw configUsage
+  | "--emit-list" :: path :: rest =>
+    if emitListFile.isSome then throw "--emit-list may be specified only once"
+    else parseConfigArgs rest positionals (some path) metadataOut coordinator hoverIdOffset
+  | "--metadata-out" :: path :: rest =>
+    if metadataOut.isSome then throw "--metadata-out may be specified only once"
+    else parseConfigArgs rest positionals emitListFile (some path) coordinator hoverIdOffset
+  | "--coordinator" :: rest =>
+    parseConfigArgs rest positionals emitListFile metadataOut true hoverIdOffset
+  | "--hover-id-offset" :: value :: rest =>
+    match value.toNat? with
+    | some offset => parseConfigArgs rest positionals emitListFile metadataOut coordinator offset
+    | none => throw s!"invalid --hover-id-offset value: {value}"
+  | positional :: rest =>
+    if positional.startsWith "--" then throw s!"unknown option: {positional}"
+    else parseConfigArgs rest (positionals.push positional) emitListFile metadataOut coordinator hoverIdOffset
+
+def getConfig (args : List String) : Except String Config :=
+  parseConfigArgs args
+
+private def Config.emitsSharedOutput (config : Config) : Bool :=
+  config.coordinator || config.emitListFile.isNone
+
+private def loadEmitList : Option System.FilePath → IO (Option (Array Name))
+  | none => pure none
+  | some path => do
+    let contents ← IO.FS.readFile path
+    pure <| some <| contents.splitOn "\n"
+      |>.filter (fun line => !line.trimAscii.isEmpty)
+      |>.map (fun line => line.trimAscii.toName)
+      |>.toArray

